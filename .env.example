# =============================================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (для production)
# =============================================================================

# Redis Configuration
# Для Vercel используйте Upstash Redis: https://upstash.com/
REDIS_URL=redis://localhost:6379

# Session Configuration
# ВАЖНО: Сгенерируйте безопасный ключ длиной минимум 32 символа
# Можно использовать: openssl rand -base64 32
SESSION_SECRET=your-secret-key-here-change-in-production-min-32-chars

# CSRF Protection Secret
# ВАЖНО: Сгенерируйте безопасный ключ: openssl rand -base64 32
CSRF_SECRET=your-csrf-secret-change-in-production-min-32-chars

# =============================================================================
# АУТЕНТИФИКАЦИЯ
# =============================================================================

# PIN для входа членов жюри (обязательно измените!)
JURY_ACCESS_PIN=CHANGE_ME_IN_PRODUCTION

# Учётные данные пользователей (формат: username:password:role,username:password:role)
# Роли: Admin, Event_Manager, Jury
# Пример: admin:SecurePass123!:Admin,manager:ManagerPass456!:Event_Manager
USER_CREDENTIALS=admin:CHANGE_ME:Admin,manager:CHANGE_ME:Event_Manager

# =============================================================================
# EMAIL (для отправки сертификатов)
# =============================================================================

# Используется nodemailer с Gmail SMTP
# Для Gmail необходимо создать App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Олимпиада <your-email@gmail.com>"

# =============================================================================
# ПРИЛОЖЕНИЕ
# =============================================================================

NEXT_PUBLIC_APP_NAME="Универсальная система олимпиад"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# РАЗРАБОТКА (не использовать в production!)
# =============================================================================

# В режиме development, если USER_CREDENTIALS не задан,
# будут использоваться тестовые учётные данные:
# - admin / admin123 (Admin)
# - manager / manager123 (Event_Manager)
# 
# Это ТОЛЬКО для разработки! В production обязательно задайте USER_CREDENTIALS.
